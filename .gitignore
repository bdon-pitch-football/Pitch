# Secrets — never committed. See .env.example for the full list.
.env
.env.local
.env*.local

# Dependencies / build
node_modules/
.next/
out/
dist/
/build/
.vercel/
*.tsbuildinfo

# Supabase local
.branches/
.temp/
supabase/.env

# Handles on the local throwaway database, rewritten on every reseed.
.dev-ids.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
playwright-report/
test-results/

# Never commit anything that could carry real personal data
*.csv
*.sql.gz
/dumps/
/exports/
/public/dev-uploads/

# Dev-only upload target. Real files, never committed.
/public/dev-uploads/

# Production build used to verify while `next dev` owns .next
/.next-check/

# Generated by next dev / next build / next typegen, and rewritten by each to
# point at its own dist dir — so `npm run build:check` (.next-check) left the
# tree dirty after every run. Next's own docs: add it to .gitignore and stop
# tracking it (node_modules/next/dist/docs/.../05-config/02-typescript.md).
# tsc passes without it; any next command regenerates it.
/next-env.d.ts

# The demo build (npm run demo)
/.next-demo/
docs/design/screens/

# Agent worktrees — isolated checkouts, never part of the tree they branch from (L30)
.claude/worktrees/
