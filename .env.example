# =============================================================================
# Pitch — environment variables
# Copy to .env.local and fill in. NEVER commit a filled copy.
# Entity: EBSD Enterprises Pty Ltd (ACN 701 879 718 · ABN 65 701 879 718)
#         trading as Pitch Football
# =============================================================================

# --- Supabase — the project MUST be in the SYDNEY region (D-29) ---------------
# Region cannot be changed after creation. Getting this wrong means starting over.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # lib/storage.ts + lib/waitlist-db.ts only (D-80). CI asserts this.
SUPABASE_STORAGE_BUCKET=public-images   # crests, banners, player and coach photos.
                                # Create it PUBLIC-READ in the Sydney project (D-29):
                                # these are rendered by <img> on public pages, and the
                                # sensitive decision is what gets uploaded, not who can
                                # fetch a URL nobody has. Unset in dev — uploads then
                                # go to public/dev-uploads and the walkthrough works
                                # with no configuration at all.
SUPABASE_DB_URL=                # doc 14's tests run against the database, not the app

# --- Email — Resend. Transactional and marketing are SEPARATE subdomains (D-81)
RESEND_API_KEY=
EMAIL_FROM="Pitch <hello@send.pitchfootball.com.au>"   # transactional, NOT the apex
EMAIL_WEBHOOK_SECRET=           # Resend signing secret (whsec_…) for delivery receipts
                                # at /api/webhooks/resend — they feed the consent
                                # event spine (D-78), which is what makes "bounced"
                                # and "read it and did nothing" different facts.

# --- SMS — Australian long number, prepaid credit, never a card on file (D-81) -
# Twilio. The sender MUST be a long number, not an alphanumeric sender ID: an
# alphanumeric sender cannot RECEIVE, and doc 15 §15 promises a working STOP.
SMS_ACCOUNT_SID=               # Twilio account SID (the ACxxxx one)
SMS_API_KEY=
SMS_SENDER_ID=
SMS_LONG_NUMBER=                # inbound STOP/HELP handling
SMS_WEBHOOK_SECRET=            # Twilio auth token — signs inbound STOP/HELP at
                               # /api/webhooks/sms
SMS_MONTHLY_CAP_CENTS=          # global spend cap — SMS pumping fraud is real
SMS_KILL_SWITCH=false

# --- Stripe — hosted Checkout + hosted Portal ONLY, never embedded fields (D-112)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # subscription state is written by webhook and nothing else
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=           # $54/month inc GST  (D-109 as amended)
STRIPE_PRICE_ANNUAL=            # $329/year inc GST  (D-109 as amended)

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pitchfootball.com.au
OPS_EMAILS=                     # comma-separated; who may open /ops. Empty = nobody.
SUPPORT_EMAIL=help@pitchfootball.com.au
DIGEST_RECIPIENTS=              # the 7am consent-funnel digest (D-78)
TZ=Australia/Melbourne          # every age transition evaluates here, never UTC

# --- Coming-soon site (doc 29) ------------------------------------------------
# The form is gated until the privacy policy and terms placeholders resolve
# (doc 29 §7). Anything other than "true" keeps the API shut in production.
WAITLIST_ENABLED=false
# Daily digest — one email a day, only when there were signups, counts only,
# never addresses (doc 29 §6). Vercel cron calls /api/digest with this secret.
DIGEST_TO=burak.donmez@pitch-football.com
EMAIL_REPLY_TO=burak.donmez@pitch-football.com
CRON_SECRET=                    # set in Vercel; every /api/digest and /api/jobs/*
                                # route requires it in production. Three crons are
                                # registered in vercel.json: the 7am digest, the
                                # daily purge/notify job, and the hourly outbox
                                # backstop.
