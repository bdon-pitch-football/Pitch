# =============================================================================
# Pitch — environment variables
# Copy to .env.local and fill in. NEVER commit a filled copy.
# Entity: EBSD Enterprises Pty Ltd (ACN 701 879 718 · ABN 65 701 879 718)
#         trading as Pitch Football
# =============================================================================

# --- Supabase — the project MUST be in the SYDNEY region (D-29) ---------------
# Region cannot be changed after creation. Getting this wrong means starting over.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # ONE server route only (D-80). CI asserts this.
SUPABASE_DB_URL=                # doc 14's tests run against the database, not the app

# --- Email — Resend. Transactional and marketing are SEPARATE subdomains (D-81)
RESEND_API_KEY=
EMAIL_FROM="Pitch <hello@send.pitchfootball.com.au>"   # transactional, NOT the apex
EMAIL_WEBHOOK_SECRET=           # delivery receipts feed the consent event spine (D-78)

# --- SMS — Australian long number, prepaid credit, never a card on file (D-81) -
SMS_API_KEY=
SMS_SENDER_ID=
SMS_LONG_NUMBER=                # inbound STOP/HELP handling
SMS_WEBHOOK_SECRET=
SMS_MONTHLY_CAP_CENTS=          # global spend cap — SMS pumping fraud is real
SMS_KILL_SWITCH=false

# --- Stripe — hosted Checkout + hosted Portal ONLY, never embedded fields (D-112)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # subscription state is written by webhook and nothing else
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=           # $54/month inc GST  (D-109 as amended)
STRIPE_PRICE_ANNUAL=            # $329/year inc GST  (D-109 as amended)

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pitchfootball.com.au
SUPPORT_EMAIL=help@pitchfootball.com.au
DIGEST_RECIPIENTS=              # the 7am consent-funnel digest (D-78)
TZ=Australia/Melbourne          # every age transition evaluates here, never UTC
